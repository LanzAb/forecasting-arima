{
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.tabSize": 4,
  "editor.formatOnSave": false,

  "[blade]": { "editor.tabSize": 4 },
  "[javascript]": { "editor.tabSize": 2 },
  "[json]": { "editor.tabSize": 2 },
  "[yaml]": { "editor.tabSize": 2 },

  "emmet.includeLanguages": { "blade": "html" },
  "blade.format.enable": true,

  "files.associations": {
    "*.blade.php": "blade"
  },

  // CATATAN: "**/vendor" TIDAK boleh dimasukkan ke sini.
  //
  // Intelephense ikut mematuhi files.exclude saat membangun indeksnya, jadi
  // menyembunyikan vendor/ membuat seluruh class Laravel tidak dikenali —
  // Seeder, Model, Controller, bahkan $this->command semuanya dilaporkan
  // "Undefined". Itu galat semu: kodenya tetap jalan, hanya IDE-nya yang buta.
  //
  // vendor/ tetap disembunyikan dari pencarian lewat search.exclude di bawah,
  // jadi hasil Ctrl+Shift+F tetap bersih.
  "files.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/storage/framework": true,
    "**/storage/logs": true,
    "**/bootstrap/cache": true
  },

  "search.exclude": {
    "**/vendor": true,
    "**/node_modules": true,
    "**/public/build": true,
    "**/storage": true,
    "**/composer.lock": true,
    "**/package-lock.json": true
  },

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "composer.json": "composer.lock, phpunit.xml, .editorconfig, .gitattributes, .gitignore, artisan",
    "package.json": "package-lock.json, vite.config.js, postcss.config.js, tailwind.config.js",
    ".env": ".env.example, .env.testing"
  },

  "intelephense.environment.phpVersion": "8.2.0",

  // Yang benar-benar tidak perlu diindeks Intelephense. vendor/ sengaja tidak
  // ada di sini karena justru dari sanalah definisi class Laravel dibaca.
  "intelephense.files.exclude": [
    "**/node_modules/**",
    "**/.git/**",
    "**/storage/framework/**",
    "**/bootstrap/cache/**",
    "**/public/build/**"
  ]
}
