{
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.tabSize": 4,
  "editor.formatOnSave": false,

  "[blade]": { "editor.tabSize": 4 },
  "[javascript]": { "editor.tabSize": 2 },
  "[json]": { "editor.tabSize": 2 },
  "[yaml]": { "editor.tabSize": 2 },

  "emmet.includeLanguages": { "blade": "html" },
  "blade.format.enable": true,

  "files.associations": {
    "*.blade.php": "blade"
  },

  "files.exclude": {
    "**/vendor": true,
    "**/node_modules": true,
    "**/.git": true,
    "**/storage/framework": true,
    "**/storage/logs": true,
    "**/bootstrap/cache": true
  },

  "search.exclude": {
    "**/vendor": true,
    "**/node_modules": true,
    "**/public/build": true,
    "**/storage": true,
    "**/composer.lock": true,
    "**/package-lock.json": true
  },

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "composer.json": "composer.lock, phpunit.xml, .editorconfig, .gitattributes, .gitignore, artisan",
    "package.json": "package-lock.json, vite.config.js, postcss.config.js, tailwind.config.js",
    ".env": ".env.example, .env.testing"
  },

  "intelephense.environment.phpVersion": "8.2.0"
}
